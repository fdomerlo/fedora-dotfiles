#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

DEFAULT_BOX="debian-box"
export DBX_CONTAINER_MANAGER=podman

log() {
  printf '\n==> %s\n' "$1"
}

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "ERROR: Falta el comando requerido '$1'." >&2
    exit 1
  }
}

box_create() {
  local name="${1:-$DEFAULT_BOX}"
  BOX_NAME="$name" bash "$REPO_DIR/boxes/debian-box.sh"
}

box_enter() {
  local name="${1:-$DEFAULT_BOX}"
  require distrobox
  exec distrobox enter "$name"
}

box_list() {
  require distrobox
  distrobox list
}

doctor() {
  bash "$REPO_DIR/scripts/verify.sh"
}

case "${1:-}" in
  box)
    case "${2:-}" in
      create) box_create "${3:-$DEFAULT_BOX}" ;;
      enter)  box_enter "${3:-$DEFAULT_BOX}" ;;
      list)   box_list ;;
      *)
        echo "Uso: devctl box {create|enter|list} [nombre]" >&2
        exit 1
        ;;
    esac
    ;;
  doctor)
    doctor
    ;;
  *)
    echo "Uso:"
    echo "  devctl box create [debian-box]"
    echo "  devctl box enter [debian-box]"
    echo "  devctl box list"
    echo "  devctl doctor"
    ;;
esac
