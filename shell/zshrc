# ---------------------------------------------------------------------------
# Zsh y Oh My Zsh - Configuración Principal (Portable e Idempotente)
# ---------------------------------------------------------------------------

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""

plugins=(
  git
  common-aliases
  extract
  colored-man-pages
  zsh-autosuggestions
  zsh-syntax-highlighting
)

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# ---------------------------------------------------------------------------
# Consolidación de PATH y Toolchains (sin duplicados ni rutas estáticas)
# ---------------------------------------------------------------------------

# Garantizar unicidad de entradas en PATH dentro de Zsh
typeset -U path PATH

# Cargar entorno local (ej. uv) si existe
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"

export FNM_DIR="$HOME/.local/share/fnm"
export SDKMAN_DIR="$HOME/.sdkman"

path=(
  "$HOME/.local/bin"
  "$HOME/.opencode/bin"
  "$FNM_DIR"
  "$HOME/bin"
  /usr/local/bin
  $path
)
export PATH

# --- FNM (Node.js) ---
if command -v fnm &>/dev/null; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# --- SDKMAN (Java / JVM) ---
if [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]]; then
  source "$SDKMAN_DIR/bin/sdkman-init.sh"
fi

# Reasegurar deduplicación de PATH tras inicializadores externos
typeset -U path PATH

# ---------------------------------------------------------------------------
# Prompt personalizado con vcs_info e indicador de contenedor Distrobox
# ---------------------------------------------------------------------------

setopt prompt_subst
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' (%b)'

precmd() {
  vcs_info
}

if [[ -n "${CONTAINER_ID:-}" ]]; then
  PROMPT='📦[%F{yellow}$CONTAINER_ID%f] %F{cyan}%n%f %1~%F{yellow}${vcs_info_msg_0_}%f '
else
  PROMPT='%F{cyan}%n%f %1~%F{yellow}${vcs_info_msg_0_}%f '
fi
